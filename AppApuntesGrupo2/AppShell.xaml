<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="AppApuntesGrupo2.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:AppApuntesGrupo2"
    xmlns:views="clr-namespace:AppApuntesGrupo2.Views"
    Shell.FlyoutBehavior="Disabled"
    Title="AppApuntesGrupo2">

    <TabBar>
        <ShellContent Title="Clima"  ContentTemplate="{DataTemplate views:WeatherView}" />
        <ShellContent Title="Notas"  ContentTemplate="{DataTemplate views:NotePageView}" />
        <ShellContent Title="Acerca de" ContentTemplate="{DataTemplate views:AboutPageView}" />
        <ShellContent Title="Recordatorio"  ContentTemplate="{DataTemplate views:RecordatorioPageView}" />
    </TabBar>
</Shell>

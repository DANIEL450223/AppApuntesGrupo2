<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:AppApuntesGrupo2.ViewModels"
             x:Class="AppApuntesGrupo2.Views.WeatherView"
             BackgroundColor="#52a6e8">

    <ContentPage.BindingContext>
        <vm:WeatherViewModel />
    </ContentPage.BindingContext>

    <Grid Padding="30" RowDefinitions="Auto,*,Auto">
        <!-- Header -->
        <Label Text="CLIMA ACTUAL" FontSize="24" TextColor="White" HorizontalOptions="Center" />

        <!-- Main weather info -->
        <VerticalStackLayout Grid.Row="1" Spacing="15" HorizontalOptions="Center">
            <Label Text="{Binding Temperature}" FontSize="72" FontAttributes="Bold" TextColor="White"/>
            <Label Text="{Binding Time}" FontSize="18" TextColor="White" />
            <Image Source="sunny.png" WidthRequest="120" HeightRequest="120" HorizontalOptions="Center"/>
        </VerticalStackLayout>

        <!-- Details -->
        <Frame Grid.Row="2" CornerRadius="16" BackgroundColor="#7dbffd" Padding="18" HorizontalOptions="Center" WidthRequest="250">
            <VerticalStackLayout Spacing="6">
                <Label Text="Humedad:" FontSize="18" TextColor="White" />
                <Label Text="{Binding Humidity}" FontSize="18" TextColor="White" />
                <Label Text="Lluvia:" FontSize="18" TextColor="White" />
                <Label Text="{Binding Rain}" FontSize="18" TextColor="White" />
            </VerticalStackLayout>
        </Frame>
    </Grid>
</ContentPage>

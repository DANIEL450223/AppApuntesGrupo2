<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="AppApuntesGrupo2.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:AppApuntesGrupo2"
    xmlns:views="clr-namespace:AppApuntesGrupo2.Views"
    Shell.FlyoutBehavior="Disabled"
    Title="AppApuntesGrupo2">

    <TabBar>
        <ShellContent Title="Clima" Icon="sunny.png" ContentTemplate="{DataTemplate views:WeatherView}" />
        <ShellContent Title="Notas" Icon="note.png" ContentTemplate="{DataTemplate views:NotePageView}" />
        <ShellContent Title="Acerca de" Icon="info.png" ContentTemplate="{DataTemplate views:AboutPageView}" />
    </TabBar>
</Shell>
